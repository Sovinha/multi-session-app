{
  "name": "multi-app",
  "version": "4.0.0",
  "description": "Multi 4.0 - Multi-session web engine dashboard with single-screen view mode, background focus active state, auto-save logins and performance optimizations",
  "main": "electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build:react": "vite build",
    "dist:win": "npm run build:react && electron-builder --win",
    "package:app": "npm run build:react && npx electron-packager . \"Multi\" --platform=win32 --arch=x64 --out=build_app --overwrite --prune=true --ignore=\"^/(dist_electron|build_app|release|.*\\.zip)\" && powershell -Command \"if (Test-Path 'multi 4.0.zip') { Remove-Item 'multi 4.0.zip' -Force }; Add-Type -AssemblyName System.IO.Compression.FileSystem; [System.IO.Compression.ZipFile]::CreateFromDirectory('build_app/Multi-win32-x64', 'multi 4.0.zip')\"",
    "start": "electron ."
  },
  "build": {
    "appId": "com.multi.app",
    "productName": "Multi",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Multi"
    }
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  }
}
